{
  "name": "nusmac-document",
  "productName": "Nusmac Document",
  "version": "1.8.0",
  "description": "Nusmac Document - PDF, Word ve resim düzenleyici",
  "main": "app/main.js",
  "scripts": {
    "build:html": "node tools/build.js",
    "start": "npm run build:html && electron .",
    "dist": "npm run build:html && electron-builder --win",
    "test": "npm run build:html && node tests/e2e.js",
    "fixtures": "node tools/make-fixtures.js",
    "test:electron": "npm run build:html && node tests/electron-smoke.js"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "playwright": "^1.63.0"
  },
  "build": {
    "appId": "com.nusmac.document",
    "productName": "Nusmac Document",
    "files": [
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "app/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Nusmac Document",
      "artifactName": "NusmacDocument-Kurulum-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": [
          "pdf",
          "docx",
          "jpg",
          "jpeg",
          "png",
          "tif",
          "tiff"
        ],
        "name": "Belge",
        "role": "Editor"
      }
    ],
    "portable": {
      "artifactName": "NusmacDocument-Tasinabilir-${version}.${ext}"
    }
  }
}
